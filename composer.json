{
    "name": "flipboxfactory/saml-idp",
    "description": "SAML Identity Provider",
    "version": "5.0.11",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "cms",
        "craftcms",
        "saml",
        "sso",
        "idp",
        "identity provider",
        "federated authentication",
        "yii2"
    ],
    "require": {
        "craftcms/cms": "^5.10.8",
        "flipboxfactory/saml-core": "^5.0.12",
        "flipboxfactory/keychain": "^5.0.3"
    },
    "require-dev": {
        "codeception/codeception": "^5.2",
        "codeception/module-asserts": "^3.0",
        "codeception/module-yii2": "^1.1.9",
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.1",
        "vlucas/phpdotenv": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "flipbox\\saml\\idp\\": "src/"
        }
    },
    "scripts": {
        "test": "codecept run unit",
        "test-coverage": "codecept run unit --coverage --coverage-xml --coverage-text",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "check": [
            "@check-cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "flipbox\\saml\\idp\\tests\\": "tests/"
        }
    },
    "support": {
        "email": "support@flipboxfactory.com",
        "issues": "https://github.com/flipboxfactory/saml-idp/issues?state=open",
        "source": "https://github.com/flipboxfactory/saml-idp",
        "docs": "https://github.com/flipboxfactory/saml-idp",
        "rss": "https://github.com/flipboxfactory/saml-idp/commits/master.atom"
    },
    "extra": {
        "name": "SAML Identity Provider",
        "version": "5.0.11",
        "schemaVersion": "0.1.0",
        "handle": "saml-idp",
        "class": "flipbox\\saml\\idp\\Saml",
        "developer": "Flipbox Digital",
        "developerUrl": "https://www.flipboxdigital.com",
        "changelogUrl": "https://raw.githubusercontent.com/flipboxfactory/saml-idp/master/CHANGELOG.md",
        "downloadUrl": "https://github.com/flipboxfactory/saml-idp/archive/master.zip"
    }
}
